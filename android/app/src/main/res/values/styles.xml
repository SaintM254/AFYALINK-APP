<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- =====================================================================
         Type scale. Everything is a clean geometric sans (Roboto / SF-adjacent)
         with tight negative tracking on the big sizes, Apple style.
         ===================================================================== -->
    <style name="Text.AfyaLink.Eyebrow">
        <item name="android:textSize">@dimen/text_eyebrow</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.AfyaLink.Eyebrow.OnBrand">
        <item name="android:textColor">@color/text_on_brand_muted</item>
    </style>

    <style name="Text.AfyaLink.Hero">
        <item name="android:textSize">@dimen/text_hero</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.045</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.AfyaLink.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.AfyaLink.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.AfyaLink.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.AfyaLink.Metric">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.AfyaLink.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="Text.AfyaLink.BodySmall">
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="Text.AfyaLink.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="Text.AfyaLink.Value">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- =====================================================================
         Controls. Every action control is icon-only: no visible label, but a
         content description for TalkBack.
         ===================================================================== -->
    <style name="Widget.AfyaLink.IconButton">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:padding">@dimen/space_3</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/text_primary</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="Widget.AfyaLink.IconButton.OnBrand">
        <item name="android:tint">@color/text_on_brand</item>
    </style>

    <style name="Widget.AfyaLink.IconButton.Small">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">@dimen/space_2</item>
    </style>

    <style name="Widget.AfyaLink.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/brand_teal</item>
        <item name="android:textColor">@color/brand_white</item>
        <item name="iconTint">@color/brand_white</item>
        <item name="iconSize">@dimen/icon_md</item>
        <item name="iconPadding">@dimen/space_2</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="rippleColor">@color/ripple_on_brand</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.AfyaLink.PrimaryButton.OnBrand" parent="Widget.AfyaLink.PrimaryButton">
        <item name="backgroundTint">@color/brand_white</item>
        <item name="android:textColor">@color/brand_ink</item>
        <item name="iconTint">@color/brand_ink</item>
        <item name="rippleColor">@color/ripple_ink</item>
    </style>

    <style name="Widget.AfyaLink.GhostButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_on_brand</item>
        <item name="iconTint">@color/text_on_brand</item>
        <item name="iconSize">@dimen/icon_md</item>
        <item name="iconPadding">@dimen/space_2</item>
        <item name="strokeColor">@color/text_on_brand_muted</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="rippleColor">@color/ripple_on_brand</item>
    </style>

    <style name="Widget.AfyaLink.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand_teal</item>
        <item name="iconTint">@color/brand_teal</item>
        <item name="iconSize">@dimen/icon_sm</item>
        <item name="rippleColor">@color/ripple_ink</item>
    </style>

    <style name="Widget.AfyaLink.Field">
        <item name="android:background">@null</item>
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">3</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">@dimen/space_1</item>
        <item name="android:paddingBottom">@dimen/space_1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <style name="Widget.AfyaLink.Input">
        <item name="android:background">@null</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:paddingTop">@dimen/space_2</item>
        <item name="android:paddingBottom">@dimen/space_2</item>
    </style>

    <style name="Widget.AfyaLink.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/hairline</item>
    </style>

    <style name="Widget.AfyaLink.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:paddingStart">@dimen/space_5</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="android:paddingTop">@dimen/space_3</item>
        <item name="android:paddingBottom">@dimen/space_3</item>
    </style>

    <style name="Widget.AfyaLink.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>
</resources>
