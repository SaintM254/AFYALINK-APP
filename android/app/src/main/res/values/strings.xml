         About
         ===================================================================== -->
    <string name="about_eyebrow">ABOUT</string>
    <string name="about_title">AfyaLink</string>
    <string name="about_version">Version %1$s · build %2$d</string>
    <string name="about_mission">Offline-first blood pressure tracking that pairs with a consumer cuff and keeps every reading encrypted on the phone until you decide otherwise.</string>
    <string name="about_disclaimer_title">Not a medical device</string>
    <string name="about_disclaimer_body">AfyaLink records what your monitor shows and grades it against published WHO / ISH bands. It does not diagnose, treat or replace a clinician. In an emergency call your local emergency number.</string>
    <string name="about_privacy_title">Your data stays yours</string>
    <string name="about_privacy_body">Readings are encrypted with AES-256-GCM before they touch the filesystem. The keys live in the Android Keystore and never leave the device. Sync is a local demo relay by default.</string>
    <string name="about_source_title">Source and licence</string>
    <string name="about_source_body">AfyaLink v1.0.0 is released as a signed APK from GitHub Releases. The project is public — issues and pull requests are welcome.</string>
    <string name="about_open_repo">Open the repository</string>
    <string name="about_references_title">Clinical references</string>
    <string name="about_references_body">WHO / International Society of Hypertension blood pressure classification. 2017 ACC/AHA home-monitoring guidance. Values are educational bands, not a diagnosis.</string>
    <string name="about_checksum">Release checksum SHA-256</string>

