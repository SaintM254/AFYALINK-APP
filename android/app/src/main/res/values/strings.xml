    <string name="sync_eyebrow">VAULT</string>
    <string name="sync_title">Sync &amp; data</string>
    <string name="sync_mode">Sync mode</string>
    <string name="sync_mode_offline">Offline</string>
    <string name="sync_mode_demo">Demo relay</string>
    <string name="sync_mode_https">HTTPS relay</string>
    <string name="sync_mode_offline_body">Readings stay in the encrypted queue on this device. Nothing is transmitted.</string>
    <string name="sync_mode_demo_body">Runs the real RSA-3072 handshake and AES-256-GCM transmission against an on-device relay, so no health data leaves the phone. Ideal for demos.</string>
    <string name="sync_mode_https_body">Requires an HTTPS endpoint you control, plus the compliance work described below. Disabled until a URL is saved.</string>
    <string name="sync_endpoint">Endpoint</string>
    <string name="sync_endpoint_hint">https://your-relay.example/afya</string>
    <string name="sync_endpoint_saved">Endpoint saved</string>
    <string name="sync_endpoint_insecure">Only https:// endpoints are accepted</string>
    <string name="sync_endpoint_locked">Saving a custom endpoint stays disabled in this build. See docs/PRIVACY-COMPLIANCE.md.</string>
    <string name="sync_queued">%1$d readings queued</string>
    <string name="sync_queued_none">Queue is empty</string>
    <string name="sync_last">Last sync %1$s</string>
    <string name="sync_never">Never synced</string>
    <string name="sync_now">Sync now</string>
    <string name="sync_running">Handshaking and transmitting…</string>
    <string name="sync_done">%1$d readings verified by the local demo relay. No data left this device.</string>
    <string name="sync_nothing">Everything is already transmitted</string>
    <string name="sync_failed">Sync failed. Readings stay safely queued.</string>
    <string name="sync_compliance_title">Why the relay is local</string>
    <string name="sync_compliance_body">Blood pressure is health data. Under HIPAA a covered entity needs a signed business associate agreement with every processor that touches it, plus audit controls, access logging, breach notification and a documented risk analysis; GDPR and Kenya Data Protection Act 2019 add lawful-basis, residency and data-subject-rights duties. This build therefore ships no cloud endpoint: it proves the encrypted pipeline end to end on the device and leaves the compliant backend to your own infrastructure. Read docs/PRIVACY-COMPLIANCE.md before enabling HTTPS.</string>
    <string name="sync_export_title">Take your data with you</string>
    <string name="sync_export_encrypted">Encrypted archive</string>
    <string name="sync_export_encrypted_body">Single .afya file, AES-256-GCM with a passphrase you choose.</string>
    <string name="sync_export_csv">Plain CSV</string>
    <string name="sync_export_csv_body">Readable by any spreadsheet. Unencrypted — share only with your clinician.</string>
    <string name="sync_export_passphrase_title">Protect the archive</string>
    <string name="sync_export_passphrase_body">Choose a passphrase of at least 8 characters. Without it the archive cannot be opened.</string>
    <string name="sync_export_passphrase_short">Use at least 8 characters</string>
    <string name="sync_export_done">Archive ready</string>
    <string name="sync_export_csv_done">CSV ready</string>
    <string name="sync_export_failed">Export failed</string>
    <string name="sync_no_app">No app available to receive the file</string>
    <string name="sync_security_details">Security details</string>
    <string name="sync_transmitted_count">Transmitted</string>
    <string name="sync_device_fingerprint">Device key</string>
    <string name="sync_session_info">Each sync derives a fresh AES-256 session key and wraps it with the relay public key using RSA-3072 OAEP, the classic hybrid handshake.</string>

